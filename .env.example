# Copy this file to `.env.local` and fill in real values.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Canonical site URL, used for metadata, canonical links, sitemap and JSON-LD.
# Set to your production origin (custom domain, or the Cloudflare Workers URL
# before the custom domain is attached), e.g. https://imloreno.com
NEXT_PUBLIC_SITE_URL="https://imloreno.com"

# Example server-only secret (never prefix with NEXT_PUBLIC_).
# DATABASE_URL="postgres://user:password@localhost:5432/app"
