# Copy this file to `.env.local` and fill in real values.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Canonical site URL, used for metadata, canonical links, sitemap and JSON-LD.
# Set to your production origin (custom domain, or the Cloudflare Workers URL
# before the custom domain is attached), e.g. https://imloreno.com
NEXT_PUBLIC_SITE_URL="https://imloreno.com"

# Search-engine verification tokens (optional). These are public — they appear in
# the page HTML — and are read at build time. Add when you register the site.
#   Google Search Console -> URL prefix -> HTML tag -> content value
#   Bing Webmaster Tools   -> meta tag -> content value
# GOOGLE_SITE_VERIFICATION=""
# BING_SITE_VERIFICATION=""

# Cloudflare Web Analytics beacon token (optional, privacy-first, cookieless).
# Dashboard -> Web Analytics -> add site -> copy the token.
# NEXT_PUBLIC_CF_BEACON_TOKEN=""

# Example server-only secret (never prefix with NEXT_PUBLIC_).
# DATABASE_URL="postgres://user:password@localhost:5432/app"
