{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "response-store",
	"main": "./node_modules/@cloudflare/workers-response-store/dist/service.js",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"cache": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "CACHE_METADATA",
				"class_name": "CacheMetadata"
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "CACHE_BODIES",
			"bucket_name": "vinext-response-bodies"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"CacheMetadata"
			]
		}
	]
}